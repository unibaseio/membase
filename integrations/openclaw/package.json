{
  "name": "@unibaseio/membase",
  "version": "0.1.1",
  "description": "Membase memory for OpenClaw: your Membase account as the agent's memory slot, with search, save and profile tools.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unibaseio/membase.git",
    "directory": "integrations/openclaw"
  },
  "homepage": "https://docs.membase.com",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "memory",
    "membase",
    "long-term-memory"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build && vitest run",
    "plugin:validate": "npm run build && openclaw plugins validate --entry ./dist/index.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "typebox": "1.3.34",
    "membase-sdk": "npm:@unibaseio/membase@^0.3.1"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "clawhub": "^0.23.3",
    "openclaw": "2026.10.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.1",
      "minGatewayVersion": "2026.10.1"
    },
    "build": {
      "openclawVersion": "2026.10.5",
      "pluginSdkVersion": "2026.10.5"
    },
    "install": {
      "minHostVersion": ">=2026.10.1"
    }
  }
}
