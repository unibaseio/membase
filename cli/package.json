{
  "name": "@unibaseio/membase-cli",
  "version": "0.3.1",
  "description": "The `membase` command for the hosted Membase API, without Python. Local memory, `serve` and `mcp` are in the Python package unibaseio-membase.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "membase": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "membase",
    "memory",
    "agent-memory",
    "cli",
    "ai"
  ],
  "homepage": "https://membase.com",
  "dependencies": {
    "@unibaseio/membase": "^0.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.6.2",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unibaseio/membase-ai.git",
    "directory": "cli"
  }
}
